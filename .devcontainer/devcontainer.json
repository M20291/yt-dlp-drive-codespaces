{
  "name": "YouTube Downloader",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "postCreateCommand": "apt-get update && apt-get install -y python3 python3-pip && pip3 install yt-dlp && chmod +x download_metadata.sh",
  "customizations": {
    "vscode": {
      "tasks": {
        "version": "2.0.0",
        "tasks": [
          {
            "label": "Run metadata download",
            "type": "shell",
            "command": "bash download_metadata.sh",
            "problemMatcher": []
          }
        ]
      }
    }
  }
}